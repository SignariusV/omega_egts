{
  "name": "Верификация (SMS) dynamic",
  "scenario_version": "1",
  "gost_version": "ГОСТ 33465-2015",
  "timeout": 60,
  "description": "Первоначальная настройка УСВ через SMS с динамической генерацией пакетов",
  "channels": ["sms"],
  "variables": {
    "packet_id": 27,
    "record_id": 42,
    "service_type": 4,
    "recipient_service_type": 4,
    "unit_id": 1
  },
  "steps": [
    {
      "name": "Настройка GPRS/APN",
      "type": "send",
      "channel": "sms",
      "build": {
        "gost_version": "2015",
        "packet": {
          "packet_id": "{{packet_id}}",
          "packet_type": "APPDATA",
          "records": [
            {
              "record_id": "{{record_id}}",
              "service_type": "COMMANDS",
              "recipient_service_type": "COMMANDS",
              "rsod": true,
              "subrecords": [
                {
                  "subrecord_type": "COMMAND_DATA",
                  "data": {
                    "ct": "COM",
                    "cct": "OK",
                    "cid": 0,
                    "sid": 0,
                    "cd": {
                      "adr": 0,
                      "act": "SET",
                      "sz": 0,
                      "ccd": "EGTS_GPRS_APN",
                      "dt": "internet"
                    }
                  }
                }
              ]
            }
          ]
        }
      },
      "timeout": 60,
      "description": "Отправка настроек GPRS/APN (internet)"
    },
    {
      "name": "Подтверждение APN",
      "type": "expect",
      "channel": "sms",
      "packet_type": "CT_COMCONF",
      "timeout": 30,
      "checks": {
        "subrecord_type": "EGTS_SR_COMMAND_DATA",
        "ct": 1,
        "cid": 0
      },
      "description": "УСВ подтверждает приём настроек APN"
    },
    {
      "name": "Настройка адреса сервера",
      "type": "send",
      "channel": "sms",
      "build": {
        "gost_version": "2015",
        "packet": {
          "packet_id": "{{packet_id}}",
          "packet_type": "APPDATA",
          "records": [
            {
              "record_id": "{{record_id}}",
              "service_type": "COMMANDS",
              "recipient_service_type": "COMMANDS",
              "rsod": true,
              "subrecords": [
                {
                  "subrecord_type": "COMMAND_DATA",
                  "data": {
                    "ct": "COM",
                    "cct": "OK",
                    "cid": 1,
                    "sid": 0,
                    "cd": {
                      "adr": 0,
                      "act": "SET",
                      "sz": 0,
                      "ccd": "EGTS_SET_SERVER_ADDRESS_V2",
                      "dt": "200.20.2.171:9090"
                    }
                  }
                }
              ]
            }
          ]
        }
      },
      "timeout": 5,
      "description": "Отправка адреса и порта сервера"
    },
    {
      "name": "Подтверждение адреса",
      "type": "expect",
      "channel": "sms",
      "packet_type": "CT_COMCONF",
      "timeout": 5,
      "checks": {
        "subrecord_type": "EGTS_SR_COMMAND_DATA",
        "ct": 1,
        "cid": 1
      },
      "description": "УСВ подтверждает приём адреса сервера"
    },
    {
      "name": "Назначение UNIT_ID",
      "type": "send",
      "channel": "sms",
      "build": {
        "gost_version": "2015",
        "packet": {
          "packet_id": "{{packet_id}}",
          "packet_type": "APPDATA",
          "records": [
            {
              "record_id": "{{record_id}}",
              "service_type": "COMMANDS",
              "recipient_service_type": "COMMANDS",
              "rsod": true,
              "subrecords": [
                {
                  "subrecord_type": "COMMAND_DATA",
                  "data": {
                    "ct": "COM",
                    "cct": "OK",
                    "cid": 2,
                    "sid": 0,
                    "cd": {
                      "adr": 0,
                      "act": "SET",
                      "sz": 0,
                      "ccd": "EGTS_UNIT_ID",
                      "dt": "{{unit_id}}"
                    }
                  }
                }
              ]
            }
          ]
        }
      },
      "timeout": 5,
      "description": "Назначение уникального идентификатора УСВ (EGTS_UNIT_ID)"
    },
    {
      "name": "Ответ с UNIT_ID",
      "type": "expect",
      "channel": "sms",
      "packet_type": "CT_COMCONF",
      "timeout": 5,
      "checks": {
        "subrecord_type": "EGTS_SR_COMMAND_DATA",
        "ct": 1,
        "cid": 2
      },
      "capture": {
        "unit_id": "data"
      },
      "description": "УСВ возвращает UNIT_ID"
    }
  ]
}
