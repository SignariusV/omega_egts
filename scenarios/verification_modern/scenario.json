{
  "name": "Верификация (SMS) enhanced",
  "scenario_version": "1",
  "gost_version": "ГОСТ 33465-2015",
  "timeout": 60,
  "description": "Первоначальная настройка УСВ через SMS. Enhanced: проверка sent_pid/record_id/subrecord_type + capture UNIT_ID + {{var}} в checks",
  "channels": ["sms"],
  "variables": {
    "packet_id": {"start": 27, "auto": true},
    "record_id": {"start": 42, "auto": true},
    "service_type": 4,
    "recipient_service_type": 4,
    "unit_id_hex": "00000001",
    "gprs_apn_dt": "internet",
    "server_address_dt": {"resolver": "server_address"}
  },
  "steps": [
    {
      "name": "Настройка GPRS/APN",
      "type": "send",
      "channel": "sms",
      "build": {
        "gost_version": "2015",
        "packet": {
          "packet_id": "{{packet_id}}",
          "packet_type": 1,
          "records": [
            {
              "record_id": "{{record_id}}",
              "service_type": "{{service_type}}",
              "recipient_service_type": "{{recipient_service_type}}",
              "rsod": true,
              "subrecords": [
                {
                  "subrecord_type": 51,
                  "data": {
                    "ct": 5,
                    "cct": 0,
                    "cid": 0,
                    "sid": 0,
                    "cd": {
                      "adr": 0,
                      "act": 2,
                      "sz": 0,
                      "ccd": 515,
                      "dt": "{{gprs_apn_dt}}"
                    }
                  }
                }
              ]
            }
          ]
        }
      },
      "timeout": 60,
      "description": "Отправка настроек GPRS/APN (internet)"
    },
    {
      "name": "Подтверждение APN",
      "type": "expect",
      "channel": "sms",
      "packet_type": "CT_COMCONF",
      "timeout": 30,
      "checks": {
        "subrecord_type": 51,
        "record_id": "{{record_id}}",
        "ct": 1,
        "cid": "{{sent_cid}}",
        "sid": "{{sent_sid}}"
      },
      "description": "УСВ подтверждает приём настроек APN: проверяем cid/sid из отправленного пакета + record_id"
    },
    {
      "name": "Настройка адреса сервера",
      "type": "send",
      "channel": "sms",
      "build": {
        "gost_version": "2015",
        "packet": {
          "packet_id": "{{packet_id}}",
          "packet_type": 1,
          "records": [
            {
              "record_id": "{{record_id}}",
              "service_type": "{{service_type}}",
              "recipient_service_type": "{{recipient_service_type}}",
              "rsod": true,
              "subrecords": [
                {
                  "subrecord_type": 51,
                  "data": {
                    "ct": 5,
                    "cct": 0,
                    "cid": 1,
                    "sid": 0,
                    "cd": {
                      "adr": 0,
                      "act": 2,
                      "sz": 0,
                      "ccd": 516,
                      "dt": "{{server_address_dt}}"
                    }
                  }
                }
              ]
            }
          ]
        }
      },
      "timeout": 5,
      "description": "Отправка адреса и порта сервера"
    },
    {
      "name": "Подтверждение адреса",
      "type": "expect",
      "channel": "sms",
      "packet_type": "CT_COMCONF",
      "timeout": 5,
      "checks": {
        "subrecord_type": 51,
        "record_id": "{{record_id}}",
        "ct": 1,
        "cid": "{{sent_cid}}",
        "sid": "{{sent_sid}}"
      },
      "description": "УСВ подтверждает приём адреса сервера: проверяем cid/sid из отправленного пакета + record_id"
    },
    {
      "name": "Назначение UNIT_ID",
      "type": "send",
      "channel": "sms",
      "build": {
        "gost_version": "2015",
        "packet": {
          "packet_id": "{{packet_id}}",
          "packet_type": 1,
          "records": [
            {
              "record_id": "{{record_id}}",
              "service_type": "{{service_type}}",
              "recipient_service_type": "{{recipient_service_type}}",
              "rsod": true,
              "subrecords": [
                {
                  "subrecord_type": 51,
                  "data": {
                    "ct": 5,
                    "cct": 0,
                    "cid": 2,
                    "sid": 0,
                    "cd": {
                      "adr": 0,
                      "act": 2,
                      "sz": 0,
                      "ccd": 1028,
                      "dt_hex": "{{unit_id_hex}}"
                    }
                  }
                }
              ]
            }
          ]
        }
      },
      "timeout": 5,
      "description": "Назначение уникального идентификатора УСВ (EGTS_UNIT_ID)"
    },
    {
      "name": "Ответ с UNIT_ID",
      "type": "expect",
      "channel": "sms",
      "packet_type": "CT_COMCONF",
      "timeout": 5,
      "checks": {
        "subrecord_type": 51,
        "record_id": "{{record_id}}",
        "ct": 1,
        "cid": "{{sent_cid}}",
        "sid": "{{sent_sid}}"
      },
      "capture": {
        "unit_id": "data"
      },
      "description": "УСВ возвращает UNIT_ID — захватываем для последующих шагов"
    }
  ]
}
